{
  "name": "chat-app",
  "version": "1.0.0",
  "description": "Advanced Real-time Chat Application with WebSockets",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node dist/infrastructure/database/migrate.js up",
    "migrate:undo": "node dist/infrastructure/database/migrate.js down",
    "migrate:status": "node dist/infrastructure/database/migrate.js status",
    "migrate:dev": "ts-node src/infrastructure/database/migrate.ts up",
    "test": "jest",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deniz1976/Chat-App.git"
  },
  "keywords": [
    "chat",
    "websocket",
    "real-time",
    "postgres",
    "cloudflare",
    "typescript",
    "node"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/deniz1976/Chat-App/issues"
  },
  "homepage": "https://github.com/deniz1976/Chat-App#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "bcrypt": "^5.1.1",
    "cookie": "^1.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "pg": "^8.14.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.3",
    "winston": "^3.17.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=18"
  }
}
